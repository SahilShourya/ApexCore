     * ------------------------------------------- */
    function toggleBillingPeriod() {
      appState.isAnnualPricing = !appState.isAnnualPricing;
      const toggleCircle = document.getElementById('toggleCircle');
      const monthlyLabel = document.getElementById('monthlyLabel');
      const annualLabel = document.getElementById('annualLabel');
      const prices = document.querySelectorAll('.plan-price');

      if (appState.isAnnualPricing) {
        toggleCircle.classList.add('translate-x-6');
        monthlyLabel.classList.remove('text-slate-900');
        monthlyLabel.classList.add('text-slate-500');
        annualLabel.classList.remove('text-slate-500');
        annualLabel.classList.add('text-slate-900');
      } else {
        toggleCircle.classList.remove('translate-x-6');
        monthlyLabel.classList.add('text-slate-900');
        monthlyLabel.classList.remove('text-slate-500');
        annualLabel.classList.add('text-slate-500');
        annualLabel.classList.remove('text-slate-900');
      }

      prices.forEach(el => {
        const val = appState.isAnnualPricing ? el.dataset.annual : el.dataset.monthly;
        el.innerText = `$${val}`;
      });
    }

