              <i data-lucide="edit-3" class="w-3.5 h-3.5"></i> Edit
            </button>
            <button onclick="deleteService('${svc.id}')" class="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold transition flex items-center gap-1">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Delete
            </button>
          </div>
        `;
        container.appendChild(item);
      });

      lucide.createIcons();
    }

    function openServiceModal(svc = null) {
      const modal = document.getElementById('serviceModal');
      const title = document.getElementById('serviceModalTitle');
      const formId = document.getElementById('serviceFormId');
      const formTitle = document.getElementById('serviceFormTitle');
      const formIcon = document.getElementById('serviceFormIcon');
      const formDesc = document.getElementById('serviceFormDesc');
      const formTag = document.getElementById('serviceFormTag');

      if (svc) {
        title.innerText = 'Edit Service';
        formId.value = svc.id;
        formTitle.value = svc.title;
        formIcon.value = svc.icon;
        formDesc.value = svc.description;
        formTag.value = svc.tag || '';
      } else {
        title.innerText = 'Add New Service';
        formId.value = '';
        formTitle.value = '';
        formIcon.value = 'cpu';
        formDesc.value = '';
        formTag.value = '';
      }

      modal.classList.remove('hidden');
    }

    function closeServiceModal() {
      document.getElementById('serviceModal').classList.add('hidden');
    }

    function editService(id) {
      const svc = appState.services.find(s => s.id === id);
      if (svc) openServiceModal(svc);
    }

    function deleteService(id) {
      if (appState.services.length <= 1) {
        showToast('You must keep at least one service active.', 'error');
        return;
      }
      appState.services = appState.services.filter(s => s.id !== id);
      renderAdminServices();
      renderPublicServices();
      showToast('Service removed from catalog.', 'info');
    }

    function handleSaveService(event) {
      event.preventDefault();

      const id = document.getElementById('serviceFormId').value;
      const title = document.getElementById('serviceFormTitle').value.trim();
      const icon = document.getElementById('serviceFormIcon').value;
      const description = document.getElementById('serviceFormDesc').value.trim();
      const tag = document.getElementById('serviceFormTag').value.trim();

      if (!title || !description) {
        showToast('Title and description are required.', 'error');
        return;
      }

      if (id) {
        // Edit existing
        const item = appState.services.find(s => s.id === id);
        if (item) {
          item.title = title;
          item.icon = icon;
          item.description = description;
          item.tag = tag;
          showToast('Service updated successfully.', 'success');
        }
      } else {
        // Add new
        appState.services.push({
          id: 'svc-' + Date.now(),
          title,
          icon,
          description,
          tag: tag || 'Enterprise'
        });
        showToast('New service published!', 'success');
      }

      closeServiceModal();
      renderAdminServices();
      renderPublicServices();
    }

    /* -------------------------------------------
     * ADMIN SITE SETTINGS
     * ------------------------------------------- */
    function syncSettingsInputs() {
      document.getElementById('settingBrandName').value = appState.settings.brandName;
      document.getElementById('settingHeroHeadline').value = appState.settings.heroHeadline;
      document.getElementById('settingHeroSubtext').value = appState.settings.heroSubtext;
      document.getElementById('settingContactEmail').value = appState.settings.contactEmail;
      document.getElementById('settingHeroBadge').value = appState.settings.heroBadge;
    }

    function handleSaveSettings(event) {
      event.preventDefault();

      appState.settings.brandName = document.getElementById('settingBrandName').value.trim();
      appState.settings.heroHeadline = document.getElementById('settingHeroHeadline').value.trim();
      appState.settings.heroSubtext = document.getElementById('settingHeroSubtext').value.trim();
      appState.settings.contactEmail = document.getElementById('settingContactEmail').value.trim();
      appState.settings.heroBadge = document.getElementById('settingHeroBadge').value.trim();

      // Apply to public DOM
      document.getElementById('navBrandName').innerText = appState.settings.brandName;
      document.getElementById('heroHeadline').innerText = appState.settings.heroHeadline;
      document.getElementById('heroSubtext').innerText = appState.settings.heroSubtext;
      document.getElementById('contactDisplayEmail').innerText = appState.settings.contactEmail;
      document.getElementById('heroBadgeText').innerText = appState.settings.heroBadge;

      showToast('Website settings updated successfully!', 'success');
    }

    /* -------------------------------------------
     * ADMIN CHARTS (CHART.JS)
     * ------------------------------------------- */
    function initAdminCharts() {
      // 1. Leads over time (Bar/Line Chart)
      const ctxLeads = document.getElementById('leadsChart');
      if (ctxLeads) {
        if (leadsChartInstance) leadsChartInstance.destroy();
        leadsChartInstance = new Chart(ctxLeads, {
          type: 'line',
          data: {
            labels: ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'],
            datasets: [
              {
                label: 'Monthly Inquiries',
                data: [14, 19, 28, 35, 42, 56],
                borderColor: '#4f46e5',
                backgroundColor: 'rgba(79, 70, 229, 0.1)',
                fill: true,
                tension: 0.35,
                borderWidth: 2.5,
                pointBackgroundColor: '#4f46e5'
              },
              {
                label: 'Unique Visitors (x1k)',
                data: [18, 22, 29, 34, 41, 48],
                borderColor: '#06b6d4',
                borderDash: [5, 5],
                fill: false,
                tension: 0.35,
                borderWidth: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
                labels: { boxWidth: 12, font: { size: 11, family: 'Plus Jakarta Sans' } }
              }
            },
            scales: {
              y: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 } } },
              x: { grid: { display: false }, ticks: { font: { size: 10 } } }
            }
          }
        });
      }

      // 2. Status Doughnut Chart
      const ctxStatus = document.getElementById('statusChart');
      if (ctxStatus) {
        if (statusChartInstance) statusChartInstance.destroy();

        const countNew = appState.leads.filter(l => l.status === 'New').length;
        const countContacted = appState.leads.filter(l => l.status === 'Contacted').length;
        const countClosed = appState.leads.filter(l => l.status === 'Closed').length;

        statusChartInstance = new Chart(ctxStatus, {
          type: 'doughnut',
          data: {
            labels: ['New', 'Contacted', 'Closed'],
            datasets: [{
              data: [countNew || 1, countContacted || 1, countClosed || 1],
              backgroundColor: ['#3b82f6', '#f59e0b', '#10b981'],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
              legend: {
                position: 'bottom',
                labels: { boxWidth: 10, font: { size: 11, family: 'Plus Jakarta Sans' } }
              }
            }
          }
        });
      }
    }

    /* -------------------------------------------
     * TOAST SYSTEM (Alert alternative)
     * ------------------------------------------- */
    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      
      let borderCol = 'border-slate-800 bg-slate-900 text-white';
      let icon = 'info';

      if (type === 'success') {
        borderCol = 'border-emerald-600 bg-slate-900 text-emerald-300';
        icon = 'check-circle';
      } else if (type === 'error') {
        borderCol = 'border-rose-600 bg-slate-900 text-rose-300';
        icon = 'alert-triangle';
      }

      toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-2xl border shadow-xl text-xs font-semibold ${borderCol} transition-all duration-300 transform translate-y-2 opacity-0`;
      toast.innerHTML = `
        <i data-lucide="${icon}" class="w-4 h-4 flex-shrink-0"></i>
        <span>${escapeHtml(message)}</span>
      `;

      container.appendChild(toast);
      lucide.createIcons();

      // Animate in
      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      // Remove after 3.5s
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    /* -------------------------------------------
     * UTILITIES & INITIALIZATION
     * ------------------------------------------- */
    function escapeHtml(text) {
      if (!text) return '';
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function renderAdminAll() {
      renderAdminLeads();
      renderAdminServices();
      syncSettingsInputs();
    }

    window.onload = function() {
      // Set current copyright year
      const yrEl = document.getElementById('currentYear');
      if (yrEl) yrEl.innerText = new Date().getFullYear();

      // Render initial state
      renderPublicServices();
      renderAdminAll();
      lucide.createIcons();
    };
  </script>
</body>
</html>
