    function toggleView(target) {
      if (target) {
        appState.view = target;
      } else {
        appState.view = (appState.view === 'public') ? 'admin' : 'public';
      }

      const publicView = document.getElementById('publicView');
      const adminView = document.getElementById('adminView');
      const toggleText = document.getElementById('viewToggleText');
      const activeModeLabel = document.getElementById('activeModeLabel');

      if (appState.view === 'admin') {
        publicView.classList.add('hidden');
        adminView.classList.remove('hidden');
        toggleText.innerText = 'Switch to Public Website';
        activeModeLabel.innerHTML = 'Current View: <strong class="text-brand-400">Admin Portal</strong>';
        initAdminCharts();
        renderAdminAll();
      } else {
        adminView.classList.add('hidden');
        publicView.classList.remove('hidden');
        toggleText.innerText = 'Switch to Admin Portal';
        activeModeLabel.innerHTML = 'Current View: <strong class="text-white">Public Site</strong>';
