    /* -------------------------------------------
     * PUBLIC CONTACT FORM SUBMISSION
     * ------------------------------------------- */
    function handleLeadSubmit(event) {
      event.preventDefault();

      const name = document.getElementById('leadName').value.trim();
      const email = document.getElementById('leadEmail').value.trim();
      const company = document.getElementById('leadCompany').value.trim() || 'N/A';
      const service = document.getElementById('leadService').value;
      const message = document.getElementById('leadMessage').value.trim();

      if (!name || !email || !message) {
        showToast('Please fill in all required fields.', 'error');
        return;
      }

      // Create new lead object
      const newLead = {
        id: 'lead-' + Date.now(),
        name,
        email,
        company,
        service,
        message,
        date: new Date().toISOString().split('T')[0],
        status: 'New'
      };

      // Push to app state
      appState.leads.unshift(newLead);

      // Reset form
      document.getElementById('publicLeadForm').reset();

      // Show UI toast feedback
      showToast('Thank you! Your inquiry has been sent to our team.', 'success');

      // Update counters in admin
      updateAdminLeadMetrics();
    }

    /* -------------------------------------------
     * ADMIN PANEL TABS CONTROLLER
     * ------------------------------------------- */
    function setAdminTab(tabName) {
      const tabs = ['overview', 'leads', 'services', 'settings'];
      tabs.forEach(t => {
        const sec = document.getElementById(`adminTab-${t}`);
        const btn = document.getElementById(`tabBtn-${t}`);
        if (t === tabName) {
          sec.classList.remove('hidden');
          if (btn) {
            btn.classList.add('bg-brand-600', 'text-white');
            btn.classList.remove('text-slate-400', 'hover:bg-slate-800');
          }
        } else {
          sec.classList.add('hidden');
          if (btn) {
            btn.classList.remove('bg-brand-600', 'text-white');
            btn.classList.add('text-slate-400', 'hover:bg-slate-800');
          }
        }
      });

      const titleMap = {
        overview: 'Dashboard Overview',
        leads: 'Inquiries & Leads Management',
        services: 'Services Catalog Management',
        settings: 'Global Site Configuration'
      };
      document.getElementById('adminSectionTitle').innerText = titleMap[tabName] || 'Dashboard';

      if (tabName === 'overview') {
        setTimeout(initAdminCharts, 50);
      }
      lucide.createIcons();
    }

    /* -------------------------------------------
     * ADMIN LEADS TABLE & FILTERS
     * ------------------------------------------- */
    function renderAdminLeads(filteredLeads = null) {
      const tbody = document.getElementById('leadsTableBody');
      const list = filteredLeads || appState.leads;
      tbody.innerHTML = '';

      const noLeadsNotice = document.getElementById('noLeadsNotice');
      if (list.length === 0) {
        noLeadsNotice.classList.remove('hidden');
      } else {
        noLeadsNotice.classList.add('hidden');
      }

      list.forEach(lead => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50/80 transition";

        // Status badge color
        let statusBadge = '';
        if (lead.status === 'New') {
          statusBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">New</span>';
        } else if (lead.status === 'Contacted') {
          statusBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">Contacted</span>';
        } else {
          statusBadge = '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">Closed</span>';
        }

        tr.innerHTML = `
          <td class="px-6 py-4">
            <div class="font-bold text-slate-900">${escapeHtml(lead.name)}</div>
            <div class="text-xs text-slate-500">${escapeHtml(lead.email)} &bull; <span class="text-slate-700">${escapeHtml(lead.company)}</span></div>
          </td>
          <td class="px-6 py-4 text-xs font-medium text-slate-800">${escapeHtml(lead.service)}</td>
          <td class="px-6 py-4 text-xs text-slate-500 max-w-xs truncate">${escapeHtml(lead.message)}</td>
          <td class="px-6 py-4 text-xs text-slate-500">${lead.date}</td>
