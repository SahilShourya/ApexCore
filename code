    function filterLeads() {
      const q = document.getElementById('leadSearchInput').value.toLowerCase();
      const status = document.getElementById('leadFilterStatus').value;

      const filtered = appState.leads.filter(lead => {
        const matchesQuery = lead.name.toLowerCase().includes(q) ||
                             lead.email.toLowerCase().includes(q) ||
                             lead.company.toLowerCase().includes(q) ||
                             lead.message.toLowerCase().includes(q);
        const matchesStatus = (status === 'ALL') || (lead.status === status);
        return matchesQuery && matchesStatus;
      });

      renderAdminLeads(filtered);
    }

    function updateLeadStatus(id, newStatus) {
      const lead = appState.leads.find(l => l.id === id);
      if (lead) {
        lead.status = newStatus;
        showToast(`Lead status updated to ${newStatus}`, 'success');
        updateAdminLeadMetrics();
        initAdminCharts();
      }
    }

    function deleteLead(id) {
      appState.leads = appState.leads.filter(l => l.id !== id);
      renderAdminLeads();
      showToast('Lead entry removed.', 'info');
      initAdminCharts();
